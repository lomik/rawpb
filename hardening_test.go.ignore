package rawpb

import (
	"bytes"
	"errors"
	"testing"
)

// hugeLengthField encodes a length-delimited field (field 1, wire type 2)
// whose length varint is 2^63. Without the overflow guard, int(l) becomes
// negative and slicing/allocation panics.
var hugeLengthField = []byte{
	0x0a,                                                       // tag: field 1, wire type 2 (LEN)
	0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x01, // varint length = 1 << 63
}

// overlongVarint is field 1 wire type 0 (varint) followed by 11 continuation
// bytes. A well-formed 64-bit varint is at most 10 bytes.
var overlongVarint = []byte{
	0x08,                                                             // tag: field 1, wire type 0 (VARINT)
	0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x01, // 11-byte varint
}

func TestParseHugeLengthDoesNotPanic(t *testing.T) {
	called := false
	r := New(Bytes(1, func(v []byte) error {
		called = true
		return nil
	}))

	err := r.Parse(hugeLengthField)
	if err == nil {
		t.Fatal("expected error for oversized length-delimited field, got nil")
	}
	if called {
		t.Fatal("callback must not fire for truncated field")
	}
}

func TestReadHugeLengthDoesNotPanic(t *testing.T) {
	called := false
	r := New(
		MaxSize(1024),
		Bytes(1, func(v []byte) error {
			called = true
			return nil
		}),
	)

	err := r.Read(bytes.NewReader(hugeLengthField), nil)
	if err == nil {
		t.Fatal("expected error for oversized length-delimited field, got nil")
	}
	if called {
		t.Fatal("callback must not fire for truncated field")
	}
}

// A length-delimited field with no registered callback and no UnknownBytes
// handler takes the skip() path. Before the int64(n) overflow guard,
// skip(2^63) silently returned nil, and the parser reported successful
// parsing of a malformed message.
func TestReadSkipHugeLengthIsNotSilentSuccess(t *testing.T) {
	// field 5, wire type 2 (LEN), length = 1 << 63.
	input := []byte{
		0x2a,
		0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x01,
	}

	r := New() // no callbacks, no UnknownBytes -> skip() is invoked

	err := r.Read(bytes.NewReader(input), nil)
	if err == nil {
		t.Fatal("expected error for oversized skip, got silent success")
	}
}

// Same shape but via Bytes(num, nil) — hits skip() in the Read path via
// the callbackTypeBytes branch with funcBytes == nil.
func TestReadSkipHugeLengthViaNilBytesCallback(t *testing.T) {
	input := []byte{
		0x0a,
		0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x01,
	}

	r := New(Bytes(1, nil))

	err := r.Read(bytes.NewReader(input), nil)
	if err == nil {
		t.Fatal("expected error for oversized skip via nil Bytes callback, got silent success")
	}
}

func TestReadHugeLengthWithoutMaxSizeDoesNotPanic(t *testing.T) {
	// Even with the default unlimited MaxSize, the int-overflow guard in
	// readerLimit.bytes must reject a length that does not fit in int.
	called := false
	r := New(Bytes(1, func(v []byte) error {
		called = true
		return nil
	}))

	err := r.Read(bytes.NewReader(hugeLengthField), nil)
	if err == nil {
		t.Fatal("expected error for oversized length-delimited field, got nil")
	}
	if !errors.Is(err, ErrorInvalidMessage) && !errors.Is(err, ErrorTruncated) {
		// Wrapped by wrapError; just check the tail contains the error message.
		if err.Error() == "" {
			t.Fatalf("expected non-empty error, got %v", err)
		}
	}
	if called {
		t.Fatal("callback must not fire for truncated field")
	}
}

func TestParseOverlongVarint(t *testing.T) {
	called := false
	r := New(Varint(1, func(v uint64) error {
		called = true
		return nil
	}))

	err := r.Parse(overlongVarint)
	if err == nil {
		t.Fatal("expected error for varint longer than 10 bytes, got nil")
	}
	if called {
		t.Fatal("callback must not fire for malformed varint")
	}
}

func TestReadOverlongVarint(t *testing.T) {
	called := false
	r := New(Varint(1, func(v uint64) error {
		called = true
		return nil
	}))

	err := r.Read(bytes.NewReader(overlongVarint), nil)
	if err == nil {
		t.Fatal("expected error for varint longer than 10 bytes, got nil")
	}
	if called {
		t.Fatal("callback must not fire for malformed varint")
	}
}

func TestParseMaxSizeRejectsOversizedInput(t *testing.T) {
	// field 1, varint value 1  -->  two bytes total
	input := []byte{0x08, 0x01}

	called := false
	r := New(
		MaxSize(1),
		Varint(1, func(v uint64) error {
			called = true
			return nil
		}),
	)

	if err := r.Parse(input); err == nil {
		t.Fatal("expected MaxSize violation error, got nil")
	}
	if called {
		t.Fatal("callback must not fire when input exceeds MaxSize")
	}
}

func TestParseMaxSizeAllowsFittingInput(t *testing.T) {
	input := []byte{0x08, 0x01}

	var got uint64
	r := New(
		MaxSize(uint64(len(input))),
		Varint(1, func(v uint64) error {
			got = v
			return nil
		}),
	)

	if err := r.Parse(input); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got != 1 {
		t.Fatalf("callback got %d, want 1", got)
	}
}

func TestReadMaxSizeCapsStream(t *testing.T) {
	// A length-delimited field claiming 100 bytes of payload; MaxSize is 5,
	// so the parser must refuse rather than try to read 100 bytes.
	input := []byte{0x0a, 0x64} // field 1, wire type 2, length = 100

	called := false
	r := New(
		MaxSize(5),
		Bytes(1, func(v []byte) error {
			called = true
			return nil
		}),
	)

	if err := r.Read(bytes.NewReader(input), nil); err == nil {
		t.Fatal("expected error due to MaxSize, got nil")
	}
	if called {
		t.Fatal("callback must not fire for oversized field")
	}
}

func TestParseErrorsAreUnwrappable(t *testing.T) {
	cases := []struct {
		name  string
		input []byte
		want  error
	}{
		{
			name:  "invalid field number",
			input: []byte{0x00, 0x00}, // field 0
			want:  ErrorInvalidMessage,
		},
		{
			name:  "overlong varint",
			input: overlongVarint,
			want:  ErrorInvalidMessage,
		},
		{
			name: "truncated length-delimited",
			// field 1 wire type 2, length 100, no payload
			input: []byte{0x0a, 0x64},
			want:  ErrorTruncated,
		},
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			r := New(Name("test"), Bytes(1, func(v []byte) error { return nil }))
			err := r.Parse(tc.input)
			if err == nil {
				t.Fatalf("expected error, got nil")
			}
			if !errors.Is(err, tc.want) {
				t.Fatalf("errors.Is(err, %v) = false; err = %v", tc.want, err)
			}
		})
	}
}

func TestParseRejectsFieldNumberZero(t *testing.T) {
	// tag = 0x00: field number 0, wire type 0 (varint); then a varint value.
	input := []byte{0x00, 0x00}

	r := New(UnknownVarint(func(num int, v uint64) error {
		t.Fatalf("unknown handler must not fire for field number 0 (got num=%d)", num)
		return nil
	}))

	if err := r.Parse(input); err == nil {
		t.Fatal("expected error for field number 0, got nil")
	}
}

func TestReadRejectsFieldNumberZero(t *testing.T) {
	input := []byte{0x00, 0x00}

	r := New(UnknownVarint(func(num int, v uint64) error {
		t.Fatalf("unknown handler must not fire for field number 0 (got num=%d)", num)
		return nil
	}))

	if err := r.Read(bytes.NewReader(input), nil); err == nil {
		t.Fatal("expected error for field number 0, got nil")
	}
}

func TestParseRejectsFieldNumberAboveSpecMax(t *testing.T) {
	// Encode a tag with field number = 2^29 (one past the max) and wire type 0.
	// tag = (num << 3) | wt = (1<<29 << 3) | 0 = 1 << 32.
	// Varint-encoded (5 bytes: 0x80 0x80 0x80 0x80 0x10).
	input := []byte{0x80, 0x80, 0x80, 0x80, 0x10, 0x00}

	r := New(UnknownVarint(func(num int, v uint64) error {
		t.Fatalf("unknown handler must not fire for out-of-range field number (got num=%d)", num)
		return nil
	}))

	if err := r.Parse(input); err == nil {
		t.Fatal("expected error for field number > 2^29-1, got nil")
	}
}

// The maximum legal field number (2^29 - 1) must still parse.
func TestParseAcceptsMaxFieldNumber(t *testing.T) {
	// num = 2^29 - 1 = 536870911, wire type 0.
	// tag = ((1<<29 - 1) << 3) | 0 = 2^32 - 8 = 0xFFFFFFF8.
	// Varint encoding of 0xFFFFFFF8 (5 bytes):
	//   0xFFFFFFF8 = 11111111 11111111 11111111 11111000
	//   groups of 7 (LSB first): 1111000 1111111 1111111 1111111 0001111
	//   with continuation bits:   0xF8    0xFF    0xFF    0xFF    0x0F
	input := []byte{0xf8, 0xff, 0xff, 0xff, 0x0f, 0x2a}

	var got uint64
	r := New(Varint(maxFieldNumber, func(v uint64) error {
		got = v
		return nil
	}))

	if err := r.Parse(input); err != nil {
		t.Fatalf("unexpected error parsing max field number: %v", err)
	}
	if got != 42 {
		t.Fatalf("callback got %d, want 42", got)
	}
}

func TestCopyStringSurvivesInputMutation(t *testing.T) {
	// field 12, wire type 2, length 5, payload "hello"
	input := []byte{
		0x62, 0x05,
		'h', 'e', 'l', 'l', 'o',
	}

	var captured string
	r := New(CopyString(12, func(s string) error {
		captured = s
		return nil
	}))

	if err := r.Parse(input); err != nil {
		t.Fatalf("unexpected parse error: %v", err)
	}
	if captured != "hello" {
		t.Fatalf("captured %q, want %q", captured, "hello")
	}

	// Overwrite the source buffer. A safe (copied) string must not change.
	for i := 2; i < len(input); i++ {
		input[i] = 'x'
	}
	if captured != "hello" {
		t.Fatalf("CopyString did not copy: captured now %q after mutation", captured)
	}
}

// Ensure the 10-byte varint boundary is not off-by-one: a legitimate maximum
// uint64 encoded in exactly 10 bytes must still decode successfully.
func TestParseMaxLengthVarintStillWorks(t *testing.T) {
	// uint64 max = 0xFFFFFFFFFFFFFFFF encoded as varint (10 bytes)
	input := []byte{
		0x08, // tag: field 1, wire type 0
		0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01,
	}

	var got uint64
	r := New(Varint(1, func(v uint64) error {
		got = v
		return nil
	}))

	if err := r.Parse(input); err != nil {
		t.Fatalf("unexpected error decoding max-length varint: %v", err)
	}
	if got != ^uint64(0) {
		t.Fatalf("decoded %x, want %x", got, ^uint64(0))
	}
}
